{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "instructions": [
    "AGENTS.md"
  ],
  "worktree": { "directory": ".wt" },
  "permissions": [
    { "action": "skill", "resource": "*", "effect": "allow" }
  ],
  "compaction": { "auto": true, "buffer": 700000, "keep": { "tokens": 15000 } }
}
