# Dependencies (sans slash final : ignore aussi le symlink des worktrees)
node_modules

# Build output
dist/
dist-ssr/
*.local

# Tests & coverage
coverage/
test-results/
playwright-report/
blob-report/

# Session jouée par `npm run play` : rapport de diagnostic, jamais commité.
# `play-report*/` (et non `play-report/`) couvre les variantes suffixées
# (`play-report-hd/`…) et reste aligné sur `test.exclude` de vite.config.ts.
play-report*/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment
.env
.env.*
!.env.example

# Editor
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Vite
.vite/
# Cache de deps propre à chaque worktree (cf. cacheDir dans vite.config.ts) ;
# `.vite/` ne le couvre pas : le motif ne matche que le nom exact `.vite`.
.vite-cache/

# Worktrees imbriqués créés dans l'arbre (`.wt/`, `.worktrees/`) : jamais commités
.wt/
.worktrees/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# OpenCode
.opencode/cache/
